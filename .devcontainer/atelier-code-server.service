[Unit]
Description=code-server (VS Code dans le navigateur pour la demo atelier)
After=network.target

[Service]
Type=simple
User=vscode
Group=vscode
Environment=HOME=/home/vscode
Environment=USER=vscode
ExecStart=/bin/bash -c "mkdir -p /workspaces/atelier-workspace && exec /usr/bin/code-server --bind-addr 0.0.0.0:8080 --auth none /workspaces/atelier-workspace"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
