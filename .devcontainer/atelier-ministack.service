[Unit]
Description=ministack (emulateur AWS local pour la demo atelier)
After=network.target

[Service]
Type=simple
# Meme raison que atelier-terminal.service : doit tourner comme `remoteUser`
# (devcontainer.json), pas root par defaut faute de `User=`.
User=vscode
WorkingDirectory=/workspaces/atelier-workspace
ExecStart=/usr/local/bin/ministack
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
