[Unit]
Description=ministack (emulateur AWS local pour la demo atelier)
After=network.target

[Service]
Type=simple
User=vscode
Group=vscode
Environment=HOME=/home/vscode
Environment=USER=vscode
ExecStart=/bin/bash -c "mkdir -p /workspaces/atelier-workspace && cd /workspaces/atelier-workspace && exec /usr/local/bin/ministack"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
