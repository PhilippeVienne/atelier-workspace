[Unit]
Description=ttyd (terminal dans le navigateur pour la demo atelier)
After=network.target

[Service]
Type=simple
User=vscode
Group=vscode
WorkingDirectory=/workspaces/atelier-workspace
Environment=HOME=/home/vscode
Environment=USER=vscode
ExecStart=/usr/local/bin/ttyd --port 7681 --writable bash -l
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
