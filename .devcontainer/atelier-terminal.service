[Unit]
Description=ttyd (terminal dans le navigateur pour la demo atelier)
After=network.target

[Service]
Type=simple
User=vscode
Group=vscode
Environment=HOME=/home/vscode
Environment=USER=vscode
ExecStart=/bin/bash -c "mkdir -p /workspaces/atelier-workspace && cd /workspaces/atelier-workspace && exec /usr/local/bin/ttyd --port 7681 --writable bash -l"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
